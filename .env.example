# Puerto publico de la API
PORT=3000
NODE_ENV=development

# URL interna del backend (la-floresta-sur-backend)
BACKEND_URL=http://localhost:4000

# Clave de escritura. Debe coincidir con ADMIN_API_KEY del backend.
ADMIN_API_KEY=cambia-esta-clave-en-produccion

# Origenes permitidos por CORS (coma). * solo para demo publica.
CORS_ORIGINS=*

# Limite de peticiones por ventana (15 minutos)
RATE_LIMIT_MAX=600
